{
  "expo": {
    "name": "The Connoisseur",
    "slug": "the-connoisseur",
    "version": "1.0.0",
    "scheme": "connoisseur",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0B0E0D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connoisseur.app"
    },
    "android": {
      "package": "com.connoisseur.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E0D"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E0D",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
